{
  "manifest_version": 3,
  "name": "#OPENTOHELP",
  "short_name": "OPENTOHELP",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "#OPENTOHELP",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/compat.js",
      "src/config.js",
      "src/color.js",
      "src/storage.js",
      "src/recipe.js",
      "src/background.js"
    ]
  },
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://media.licdn.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/compat.js",
        "src/config.js",
        "src/selectors.js",
        "src/recipe.js",
        "src/paginator.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "opentohelp@swilsont.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
